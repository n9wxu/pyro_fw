; Half-bridge on a released pyro channel, on the pyro PIO (PIO0).
;
; The per-channel element (SET) and the common (side-set) are the two halves.
; Each word's bit 0 picks ONE side; no word can encode both, so shoot-through
; is unrepresentable. The side is held until a word asks for the other, and
; every change passes through Y+1 cycles of both off (Y: the first word).
; Until the first level arrives both sides are off. A stalled machine holds
; its side: side-set applies during a stall (RP2040 datasheet §3.2.4) and SET
; latches the pin (§3.4.10). JMP X-- tests X before decrementing (§3.4.2).
;
; SPDX-License-Identifier: MIT
;

.program pyro_bridge
.side_set 1

    pull block              side 0      ; Y: the dead band, in cycles
    mov  y, osr             side 0
    pull block              side 0      ; both off until the first level
    out  x, 1               side 0
    jmp  !x, dead_to_low    side 0
.wrap_target
dead_to_high:
    set  pins, 0            side 0
    mov  x, y               side 0
dead_h:
    jmp  x--, dead_h        side 0
    set  pins, 1            side 0      ; channel on: midpoint high
hold_high:
    pull block              side 0
    out  x, 1               side 0
    jmp  x--, hold_high     side 0
dead_to_low:
    set  pins, 0            side 0
    mov  x, y               side 0
dead_l:
    jmp  x--, dead_l        side 0
    set  pins, 0            side 1      ; common on: midpoint low
hold_low:
    pull block              side 1
    out  x, 1               side 1
    jmp  !x, hold_low       side 1
.wrap

% c-sdk {
#include "hardware/clocks.h"

/* channel_pin is the per-channel element, common_pin the shared one.
 *
 * Both are driven low and claimed as outputs BEFORE the state machine is
 * enabled, so the pads never float through the handover. */
static inline void pyro_bridge_program_init(PIO pio, uint sm, uint offset, uint channel_pin, uint common_pin,
                                            float clkdiv) {
    pio_sm_config c = pyro_bridge_program_get_default_config(offset);

    sm_config_set_set_pins(&c, channel_pin, 1);
    sm_config_set_sideset_pins(&c, common_pin);
    sm_config_set_out_shift(&c, true /* shift right */, false /* no autopull */, 32);
    sm_config_set_clkdiv(&c, clkdiv);

    pio_sm_set_pins_with_mask(pio, sm, 0, (1u << channel_pin) | (1u << common_pin));
    pio_sm_set_pindirs_with_mask(pio, sm, (1u << channel_pin) | (1u << common_pin),
                                 (1u << channel_pin) | (1u << common_pin));
    pio_gpio_init(pio, channel_pin);
    pio_gpio_init(pio, common_pin);

    pio_sm_init(pio, sm, offset, &c);
}
%}
