diff --git a/src/apogee_detector.c b/src/apogee_detector.c
new file mode 100644
index 0000000..567bcc5
--- /dev/null
+++ b/src/apogee_detector.c
@@ -0,0 +1,33 @@
+/*
+ * See apogee_detector.h.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#include "apogee_detector.h"
+#include "hold.h"
+#include <math.h>
+
+#ifndef UNSEEN_CLIMB_HOLD_MS
+#define UNSEEN_CLIMB_HOLD_MS 2000u
+#endif
+#define ARC_CURVE_MAX 0.005f /* d2(ln p)/dt2 of about 3.5 g: no rocket near apogee has it */
+#define MOVING_SIGMAS 3.0f   /* a rate beyond its own uncertainty */
+#define TOP_HOLD_MS 60u
+
+/* The estimate agrees with the readings and curves no harder than a body
+ * near the top of its flight can. */
+static bool on_an_arc(const pp_sample_t *s) {
+    return s->smooth && !s->suspect && fabsf(s->curve) < ARC_CURVE_MAX;
+}
+
+bool apogee_detected(apogee_detector_t *d, const pp_sample_t *s) {
+    if (!on_an_arc(s)) {
+        *d = (apogee_detector_t){0};
+        return false;
+    }
+    float moving = MOVING_SIGMAS * s->rate_sigma;
+    if (s->rate < -moving)
+        d->climb_seen = true;
+    uint32_t hold_ms = d->climb_seen ? TOP_HOLD_MS : UNSEEN_CLIMB_HOLD_MS;
+    return held_for(s->rate > moving, &d->descending_since, s->timestamp_ms, hold_ms);
+}
diff --git a/src/apogee_detector.h b/src/apogee_detector.h
new file mode 100644
index 0000000..d383a5d
--- /dev/null
+++ b/src/apogee_detector.h
@@ -0,0 +1,22 @@
+/*
+ * Apogee [FLT-APO-01]: the filtered state passing over the top of a
+ * ballistic arc. See docs/apogee_without_a_mach_flag.md.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef APOGEE_DETECTOR_H
+#define APOGEE_DETECTOR_H
+
+#include "pressure_processing.h"
+#include <stdbool.h>
+#include <stdint.h>
+
+typedef struct {
+    bool climb_seen;           /* this arc has shown the rocket climbing */
+    uint32_t descending_since; /* 0: not descending on this arc */
+} apogee_detector_t;
+
+/* Once a sample. True when this sample declares apogee. */
+bool apogee_detected(apogee_detector_t *d, const pp_sample_t *s);
+
+#endif
